            "refinedBy": {
              "type": "CssSelector",
              "value": "#wasteland-tradition",
              "conformsTo": "http://tools.ietf.org/rfc/rfc3236"
            }
          },
          "format": "application/ld+json",
          "language": "eng"
        }
      ],
      "created": "2026-07-13T09:34:02.117285+00:00",
      "modified": "2026-07-13T09:34:02.117285+00:00"
    },
    {
      "@context": "http://www.w3.org/ns/anno.jsonld",
      "id": "http://localhost:8181/example/book3/page2/rev1/annotation-L4-1",
      "type": "Annotation",
      "body": {
        "type": "TextualBody",
        "value": "<p>That reception is documented in <span id=\"letter-evidence\">the surviving correspondence with Maxwell Perkins</span>, in which Fitzgerald discusses the poem shortly before revising the opening of Chapter 2.</p>",
        "format": "text/html",
        "annotationType": "EditorialCommentary"
