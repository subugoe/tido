    {
      "@context": "http://www.w3.org/ns/anno.jsonld",
      "id": "http://localhost:8181/example/book3/page2/rev1/annotation-L3-1",
      "type": "Annotation",
      "body": {
        "type": "TextualBody",
        "value": "<p>The link to that tradition rests above all on <span id=\"eliot-reception\">Fitzgerald's reading of T. S. Eliot</span>, whose imagery of dust and sterile ground he adapted to a specifically American landscape of industrial refuse.</p>",
        "format": "text/html",
        "annotationType": "EditorialCommentary"
      },
      "target": [
        {
          "type": "SpecificResource",
          "source": "http://localhost:8181/example/book3/page2/rev1/annotation-L2-1",
