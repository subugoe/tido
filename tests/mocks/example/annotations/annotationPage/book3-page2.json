    {
      "@context": "http://www.w3.org/ns/anno.jsonld",
      "id": "http://localhost:8181/example/book3/page2/rev1/annotation-L2-1",
      "type": "Annotation",
      "body": {
        "type": "TextualBody",
        "value": "<p>The decay motif is not merely social: it places the chapter in the <span id=\"wasteland-tradition\">post-war wasteland tradition</span> that dominated Anglo-American writing after 1922.</p>",
        "format": "text/html",
        "annotationType": "EditorialCommentary"
      },
      "target": [
        {
          "type": "SpecificResource",
